{
  "name": "vision-compatible-subset",
  "description": "Vision subset for machines with reachable SOM, GroundingDINO, and Depth-Anything Gradio servers.",
  "environment": {
    "OPENAI_MODEL": "gpt-4o",
    "SOM_ADDRESS": "http://localhost:8080/",
    "GROUNDING_DINO_ADDRESS": "http://localhost:8081/",
    "DEPTH_ANYTHING_ADDRESS": "http://localhost:8082/"
  },
  "requirements": {
    "api_key": true,
    "vision_servers": true,
    "server_timeout_seconds": 5
  },
  "defaults": {
    "output_dir": "outputs_repro/vision_subset",
    "max_instances": 5,
    "start_index": 0
  },
  "tasks": [
    { "name": "blink_depth" },
    { "name": "blink_jigsaw" },
    { "name": "blink_spatial" },
    { "name": "mmvp" }
  ]
}
