{
  "name": "local-smoke",
  "description": "One small API-backed graph task for local end-to-end validation.",
  "environment": {
    "OPENAI_MODEL": "gpt-4o"
  },
  "requirements": {
    "api_key": true,
    "vision_servers": false
  },
  "defaults": {
    "output_dir": "outputs_repro/smoke",
    "max_instances": 1,
    "start_index": 0
  },
  "tasks": [
    {
      "name": "graph_maxflow",
      "max_instances": 1
    }
  ]
}
