{
  "name": "math-geometry-compatible-subset",
  "description": "CPU/API subset covering non-vision paper task families.",
  "environment": {
    "OPENAI_MODEL": "gpt-4o"
  },
  "requirements": {
    "api_key": true,
    "vision_servers": false
  },
  "defaults": {
    "output_dir": "outputs_repro/math_geometry_subset",
    "max_instances": 5,
    "start_index": 0
  },
  "tasks": [
    { "name": "geometry" },
    { "name": "graph_connectivity" },
    { "name": "graph_isomorphism" },
    { "name": "graph_maxflow" },
    { "name": "math_convexity" },
    { "name": "math_parity" },
    { "name": "winner_id" }
  ]
}
